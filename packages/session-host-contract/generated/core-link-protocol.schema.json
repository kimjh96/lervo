{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lervo.dev/v1/core-link-protocol.schema.json",
  "title": "CoreLinkMessage",
  "oneOf": [
    {
      "$ref": "#/$defs/CoreLinkRequest"
    },
    {
      "$ref": "#/$defs/CoreLinkResponse"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "Sequence": {
      "type": "integer",
      "minimum": 1
    },
    "EpochMilliseconds": {
      "type": "integer",
      "minimum": 0
    },
    "Code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "Parameters": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "ConversationMode": {
      "enum": [
        "native",
        "cli"
      ]
    },
    "SentImage": {
      "title": "SentImage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "data"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240000
        }
      }
    },
    "ImageMark": {
      "title": "ImageMark",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "imageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CoreLinkRequest": {
      "title": "CoreLinkRequest",
      "oneOf": [
        {
          "$ref": "#/$defs/CoreCommandRequest"
        },
        {
          "$ref": "#/$defs/CoreOpenRequest"
        },
        {
          "$ref": "#/$defs/TranscriptReadRequest"
        },
        {
          "$ref": "#/$defs/SessionExitedRequest"
        },
        {
          "$ref": "#/$defs/DecoderOpenRequest"
        },
        {
          "$ref": "#/$defs/DecoderSendRequest"
        },
        {
          "$ref": "#/$defs/DecoderInterruptRequest"
        },
        {
          "$ref": "#/$defs/DecoderOutputRequest"
        },
        {
          "$ref": "#/$defs/DecoderCloseRequest"
        }
      ]
    },
    "CoreLinkResponse": {
      "title": "CoreLinkResponse",
      "oneOf": [
        {
          "$ref": "#/$defs/CoreResultResponse"
        },
        {
          "$ref": "#/$defs/CoreFailedResponse"
        },
        {
          "$ref": "#/$defs/DecoderDecodedResponse"
        },
        {
          "$ref": "#/$defs/TranscriptPageResponse"
        }
      ]
    },
    "CoreLaunch": {
      "title": "CoreLaunch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "workspaceId",
        "conversationMode",
        "provider",
        "program",
        "arguments",
        "environment",
        "workingDirectory",
        "initialInput"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        },
        "conversationMode": {
          "$ref": "#/$defs/ConversationMode"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "initialInput": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 262144
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentRemove": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        },
        "transcript": {
          "type": "boolean"
        }
      }
    },
    "DecodedEvent": {
      "title": "DecodedEvent",
      "oneOf": [
        {
          "$ref": "#/$defs/DecodedStatus"
        },
        {
          "$ref": "#/$defs/DecodedItem"
        },
        {
          "$ref": "#/$defs/DecodedStart"
        },
        {
          "$ref": "#/$defs/DecodedDelta"
        },
        {
          "$ref": "#/$defs/DecodedFinish"
        }
      ]
    },
    "DecodedContent": {
      "title": "DecodedContent",
      "oneOf": [
        {
          "$ref": "#/$defs/UserMessageContent"
        },
        {
          "$ref": "#/$defs/AgentMessageContent"
        },
        {
          "$ref": "#/$defs/QuestionContent"
        },
        {
          "$ref": "#/$defs/ToolActivityContent"
        },
        {
          "$ref": "#/$defs/PeerMessageContent"
        },
        {
          "$ref": "#/$defs/LervoNoticeContent"
        }
      ]
    },
    "WorkspaceSummary": {
      "title": "WorkspaceSummary",
      "type": "object",
      "required": [
        "workspaceId",
        "projectId",
        "repositoryName",
        "branch",
        "title",
        "provider",
        "conversationMode",
        "sessionId",
        "preparedAt"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "repositoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "conversationMode": {
          "$ref": "#/$defs/ConversationMode"
        },
        "conversationModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ConversationMode"
          }
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "preparedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "sessions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/RoomSession"
          }
        }
      }
    },
    "WorkspaceListResult": {
      "title": "WorkspaceListResult",
      "type": "object",
      "required": [
        "workspaces"
      ],
      "properties": {
        "workspaces": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/WorkspaceSummary"
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z_]+)+$",
            "maxLength": 64
          }
        }
      }
    },
    "RepositorySummary": {
      "title": "RepositorySummary",
      "type": "object",
      "required": [
        "projectId",
        "name"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mark": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectMark"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "RepositoryListResult": {
      "title": "RepositoryListResult",
      "type": "object",
      "required": [
        "repositories"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/RepositorySummary"
          }
        }
      }
    },
    "WorkspaceStartResult": {
      "title": "WorkspaceStartResult",
      "type": "object",
      "required": [
        "workspaceId",
        "sessionId",
        "provider"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        },
        "workstreamId": {
          "$ref": "#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "base": {
          "title": "WorkspaceStartBase",
          "type": "object",
          "required": [
            "source",
            "upstream",
            "notice",
            "replayed",
            "skipped",
            "carried"
          ],
          "properties": {
            "source": {
              "enum": [
                "upstream",
                "local"
              ]
            },
            "upstream": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "notice": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z_]{1,64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replayed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "carried": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        }
      }
    },
    "ProviderCapabilities": {
      "title": "ProviderCapabilities",
      "type": "object",
      "required": [
        "nativeConversation",
        "sessionIdBinding",
        "hooks",
        "mcp",
        "systemPromptFile",
        "resume"
      ],
      "properties": {
        "nativeConversation": {
          "type": "boolean"
        },
        "sessionIdBinding": {
          "type": "boolean"
        },
        "hooks": {
          "type": "boolean"
        },
        "mcp": {
          "type": "boolean"
        },
        "systemPromptFile": {
          "type": "boolean"
        },
        "readAccess": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        }
      }
    },
    "ProviderSummary": {
      "title": "ProviderSummary",
      "type": "object",
      "required": [
        "provider",
        "displayName",
        "capabilities",
        "conversationModes",
        "preferredMode",
        "installed"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilities"
        },
        "conversationModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ConversationMode"
          }
        },
        "preferredMode": {
          "$ref": "#/$defs/ConversationMode"
        },
        "installed": {
          "type": "boolean"
        },
        "signedIn": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProviderListResult": {
      "title": "ProviderListResult",
      "type": "object",
      "required": [
        "providers",
        "defaultProvider"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          }
        },
        "defaultProvider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      }
    },
    "WorkspaceRetireResult": {
      "title": "WorkspaceRetireResult",
      "type": "object",
      "required": [
        "workspaceId",
        "worktree",
        "branch"
      ],
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Identifier"
        },
        "worktree": {
          "type": "string",
          "enum": [
            "removed",
            "absent"
          ]
        },
        "branch": {
          "type": "string",
          "enum": [
            "deleted",
            "kept",
            "absent"
          ]
        }
      }
    },
    "TurnSummary": {
      "title": "TurnSummary",
      "type": "object",
      "required": [
        "given",
        "searched",
        "cited",
        "outcome"
      ],
      "properties": {
        "given": {
          "type": "object",
          "required": [
            "documents"
          ],
          "properties": {
            "documents": {
              "type": "integer",
              "minimum": 0
            },
            "workstreamRevision": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "searched": {
          "type": "object",
          "required": [
            "documents",
            "paths"
          ],
          "properties": {
            "documents": {
              "type": "integer",
              "minimum": 0
            },
            "paths": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "cited": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "object",
          "required": [
            "repositoryChanged",
            "completion"
          ],
          "properties": {
            "repositoryChanged": {
              "type": "boolean"
            },
            "changedPaths": {
              "type": "integer",
              "minimum": 0
            },
            "workstreamRevision": {
              "type": "integer",
              "minimum": 0
            },
            "completion": {
              "type": "string",
              "maxLength": 32
            },
            "ending": {
              "type": "string",
              "maxLength": 32
            }
          }
        },
        "usage": {
          "type": "object",
          "required": [
            "inputTokens",
            "cachedInputTokens",
            "outputTokens"
          ],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "costUsd": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "TurnSummaryResult": {
      "title": "TurnSummaryResult",
      "type": "object",
      "required": [
        "turns"
      ],
      "properties": {
        "turns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/TurnSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "ProjectMark": {
      "title": "ProjectMark",
      "type": "object",
      "required": [
        "sha256",
        "mediaType"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      }
    },
    "ProjectAddResult": {
      "title": "ProjectAddResult",
      "type": "object",
      "required": [
        "projectId",
        "name",
        "displayName",
        "root",
        "source"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "enum": [
            "folder",
            "clone",
            "new"
          ]
        },
        "gitInitialized": {
          "type": "boolean"
        },
        "lervoInitialized": {
          "type": "boolean"
        }
      }
    },
    "ProjectRenameResult": {
      "title": "ProjectRenameResult",
      "type": "object",
      "required": [
        "projectId",
        "displayName"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ProjectMarkSetResult": {
      "title": "ProjectMarkSetResult",
      "type": "object",
      "required": [
        "projectId",
        "mark"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "mark": {
          "$ref": "#/$defs/ProjectMark"
        }
      }
    },
    "ProjectMarkClearResult": {
      "title": "ProjectMarkClearResult",
      "type": "object",
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ProjectMarkReadResult": {
      "title": "ProjectMarkReadResult",
      "type": "object",
      "required": [
        "projectId",
        "image"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "sha256",
                "mediaType",
                "data"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mediaType": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                },
                "data": {
                  "type": "string",
                  "maxLength": 700000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProjectUnregisterResult": {
      "title": "ProjectUnregisterResult",
      "type": "object",
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ProjectsLocationResult": {
      "title": "ProjectsLocationResult",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "AgentSummary": {
      "title": "AgentSummary",
      "type": "object",
      "required": [
        "agentId",
        "displayName",
        "roleId",
        "roleName",
        "status",
        "origin",
        "revision"
      ],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "roleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "roleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "active",
            "suspended"
          ]
        },
        "origin": {
          "enum": [
            "team",
            "lervo"
          ]
        },
        "provider": {
          "type": "string",
          "maxLength": 32
        },
        "parentAgentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "title": "AgentModel",
          "type": "object",
          "required": [
            "tier",
            "effort",
            "source"
          ],
          "properties": {
            "tier": {
              "enum": [
                "frontier",
                "strong",
                "balanced",
                "fast"
              ]
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "source": {
              "enum": [
                "role",
                "owner"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    },
    "HireableRole": {
      "title": "HireableRole",
      "type": "object",
      "required": [
        "roleId",
        "name",
        "description",
        "source"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
