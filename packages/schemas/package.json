{
  "name": "@lervo/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-validators.mjs && tsc --project tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "imports": {
    "#compiled-validators": {
      "types": "./src/compiled-validators.d.ts",
      "default": "./dist/generated/validators.js"
    }
  }
}
