      "caseId": "capture.en.explicit.01",
      "language": "en",
      "form": "explicit",
      "surface": "terminal_prompt",
      "ownerTurn": "From now on, never resolve Mac and WSL conflicts by restricting work to one host.",
      "precedingAgentTurn": null,
      "expectedClass": "durable_instruction"
    },
    {
      "caseId": "capture.en.explicit.02",
      "language": "en",
      "form": "explicit",
      "surface": "conversation",
      "ownerTurn": "Always run pnpm quality:check before you open a pull request in this repository.",
      "precedingAgentTurn": null,
      "expectedClass": "durable_instruction"
    },
    {
      "caseId": "capture.en.paraphrased.01",
      "language": "en",
      "form": "paraphrased",
      "surface": "terminal_prompt",
      "ownerTurn": "When the two machines disagree, the fix belongs in the sync mechanism itself, not in parking one of them. That is how we handle it here.",
      "precedingAgentTurn": null,
      "expectedClass": "durable_instruction"
    },
    {
      "caseId": "capture.en.paraphrased.02",
      "language": "en",
      "form": "paraphrased",
      "surface": "conversation",
      "ownerTurn": "Commit messages in this repo follow the conventional format with the package name as the scope. Keep it that way going forward.",
      "precedingAgentTurn": null,
      "expectedClass": "durable_instruction"
    },
    {
      "caseId": "capture.en.implicit_correction.01",
      "language": "en",
      "form": "implicit_correction",
      "surface": "terminal_prompt",
      "ownerTurn": "No, that is exactly what I don't want. Don't take that shortcut again.",
      "precedingAgentTurn": "I resolved the conflict by disabling the WSL worker so only the Mac writes knowledge.",
      "expectedClass": "correction_of_agent_behavior"
    },
    {
      "caseId": "capture.en.implicit_correction.02",
      "language": "en",
      "form": "implicit_correction",
      "surface": "terminal_prompt",
      "ownerTurn": "Not there. Things like that belong in the repository where every agent can see them.",
      "precedingAgentTurn": "I saved your rule about host conflicts to my private memory file so I remember it next time.",
      "expectedClass": "correction_of_agent_behavior"
    },
    {
      "caseId": "capture.en.decision.01",
      "language": "en",
      "form": "decision",
      "surface": "conversation",
      "ownerTurn": "Let's go with SQLite for the event store and drop the Postgres option entirely.",
      "precedingAgentTurn": "We can keep SQLite for the event store or add a Postgres option. Which should we pursue?",
      "expectedClass": "decision"
    },
    {
      "caseId": "capture.en.decision.02",
      "language": "en",
      "form": "decision",
      "surface": "conversation",
      "ownerTurn": "We'll ship the Discord intake first. Slack waits until next quarter.",
      "precedingAgentTurn": "Both the Discord and Slack intake paths are ready to schedule. Which one ships first?",
      "expectedClass": "decision"
    },
    {
      "caseId": "capture.en.personal.01",
      "language": "en",
      "form": "personal",
      "surface": "conversation",
      "ownerTurn": "Personally I like to review things on my phone in the evening; that's just how I work.",
