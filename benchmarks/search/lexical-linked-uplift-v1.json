        { "claimId": "approval_required", "anyOf": ["승인", "approval", "review"] },
        { "claimId": "hash_bound", "anyOf": ["hash", "해시"] },
        {
          "claimId": "one_member_maximum",
          "anyOf": ["at most one", "최대 하나", "하나만", "one member"]
