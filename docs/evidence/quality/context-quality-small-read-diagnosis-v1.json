    "smallReadPrototype": {
      "script": "import fs from 'node:fs/promises';\nimport sync from 'node:fs';\nimport {syncBuiltinESMExports} from 'node:module';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nconst repo=process.cwd();\nconst {initializeActiveFixture}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-fixture.mjs'));\nconst {activeWorker}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-worker.mjs'));\nconst parent=await fs.mkdtemp(resolve(tmpdir(),'lervo-small-read-'));const results=[];\nconst originals={open:fs.open,lstat:fs.lstat};\nconst eligible=p=>String(p).endsWith('project.yaml')||String(p).endsWith('event-contract.json');\ntry{\n for(let cycle=0;cycle<3;cycle++)for(const mode of cycle%2?['sync','async']:['async','sync'])for(const workload of ['warm','concurrent']){\n  const root=resolve(parent,`${cycle}-${mode}-${workload}`);await initializeActiveFixture(root);\n  if(mode==='sync'){\n   fs.lstat=async(p,...args)=>eligible(p)?sync.lstatSync(p,...args):originals.lstat(p,...args);\n   fs.open=async(p,...args)=>{if(!eligible(p))return originals.open(p,...args);const fd=sync.openSync(p,...args);return{stat:async(...a)=>sync.fstatSync(fd,...a),readFile:async(...a)=>sync.readFileSync(fd,...a),close:async()=>sync.closeSync(fd)}};\n   syncBuiltinESMExports();\n  }\n  const r=await activeWorker(root,'candidate',workload,4096,{warmups:2,samples:10,concurrency:4});\n  Object.assign(fs,originals);syncBuiltinESMExports();results.push({cycle,mode,workload,semanticValid:r.semanticValid,integrity:r.integrity,samples:r.samples.map(s=>s.slice(0,2))});\n }\n await fs.writeFile('/tmp/lervo-small-read-probe.json',JSON.stringify({diagnosticOnly:true,results},null,2));\n}finally{Object.assign(fs,originals);syncBuiltinESMExports();await fs.rm(parent,{recursive:true,force:true})}\n",
