  "scope": "Diagnostic-only same-process experiments, separate disposable roots, fixed fixture, no provider calls. All observations retained. Cumulative async spans overlap and cannot be summed; these measurements do not establish cold acceptance or production guarantees.",
  "experiments": {
    "fileOperations": {
      "script": "import fs from 'node:fs/promises';\nimport {syncBuiltinESMExports} from 'node:module';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nconst repo=process.cwd();\nconst {initializeActiveFixture}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-fixture.mjs'));\nconst {activeWorker}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-worker.mjs'));\nconst parent=await fs.mkdtemp(resolve(tmpdir(),'lervo-io-probe-'));\nconst results=[];\nfunction category(path){const p=String(path);return p.includes('/cas/')?'cas':p.endsWith('project.yaml')?'manifest':p.endsWith('event-contract.json')||p.includes('event-contract-activation')?'writer':p.includes('.sqlite')?'sqlite':'other'}\ntry{\n for(const workload of ['cold','warm','concurrent']){\n  const root=resolve(parent,workload);await initializeActiveFixture(root);const phases={};const restorers=[];\n  function timed(obj,key,label,after){const orig=obj[key];obj[key]=async function(...args){const start=performance.now();const result=phases[label(...args)]??={calls:0,ms:0};result.calls++;try{const value=await orig.apply(this,args);after?.(value,args);return value}finally{result.ms+=performance.now()-start}};restorers.push(()=>obj[key]=orig)}\n  for(const name of ['lstat','mkdir','readFile','link','unlink','open'])timed(fs,name,(p)=>category(p)+'.'+name,name==='open'?(handle,args)=>{for(const key of ['write','sync','close','readFile','stat'])timed(handle,key,()=>category(args[0])+'.handle.'+key)}:undefined);\n  syncBuiltinESMExports();let r;\n  try{r=await activeWorker(root,'candidate',workload,4096,{warmups:2,samples:10,concurrency:4})}finally{for(const restore of restorers.reverse())restore();syncBuiltinESMExports()}\n  results.push({workload,phases,samples:r.samples.map(s=>s.slice(0,2)),semanticValid:r.semanticValid});\n }\n await fs.writeFile('/tmp/lervo-recording-io-probe.json',JSON.stringify({diagnosticOnly:true,results},null,2));\n}finally{await fs.rm(parent,{recursive:true,force:true})}\n",
