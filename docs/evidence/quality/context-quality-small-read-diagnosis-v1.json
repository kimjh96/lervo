    "casConcurrency": {
      "script": "import {mkdtemp,rm,writeFile} from 'node:fs/promises';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nconst repo=process.cwd();\nconst {initializeActiveFixture}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-fixture.mjs'));\nconst {activeWorker}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-worker.mjs'));\nconst {FileSystemCas}=await import(resolve(repo,'packages/cas/dist/index.js'));\nconst original=FileSystemCas.prototype.putStream;\nconst parent=await mkdtemp(resolve(tmpdir(),'lervo-cas-limit-probe-'));const results=[];\ntry {\nfor(let cycle=0;cycle<3;cycle++)for(const limit of cycle%2?[3,2,1,4]:[4,1,2,3]){\n const root=resolve(parent,`${cycle}-${limit}`);await initializeActiveFixture(root);let active=0;const waiting=[];\n FileSystemCas.prototype.putStream=async function(...args){if(active>=limit)await new Promise(resolve=>waiting.push(resolve));else active++;try{return await original.apply(this,args)}finally{const next=waiting.shift();if(next)next();else active--}};\n const result=await activeWorker(root,'candidate','concurrent',4096,{warmups:2,samples:10,concurrency:4});\n results.push({cycle,limit,semanticValid:result.semanticValid,integrity:result.integrity,samples:result.samples.map(s=>s.slice(0,2))});\n FileSystemCas.prototype.putStream=original;\n}\nawait writeFile('/tmp/lervo-cas-concurrency-probe.json',JSON.stringify({diagnosticOnly:true,results},null,2));\n}finally{FileSystemCas.prototype.putStream=original;await rm(parent,{recursive:true,force:true})}\n",
