  "scope": "Instrumented diagnostics only; cold, warm and concurrent run sequentially in one process, so cold sample is not an independent fresh-process acceptance cohort. Inspector includes imports outside batch timers. Overlapping cumulative phase times are not additive; different roots and uncontrolled host conditions. No provider calls.",
  "script": "import { Session } from 'node:inspector/promises';\nimport { mkdtemp, rm, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { resolve } from 'node:path';\nconst repo=process.cwd();\nconst {initializeActiveFixture}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-fixture.mjs'));\nconst {activeWorker}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-worker.mjs'));\nconst {SQLiteEventStore}=await import(resolve(repo,'packages/event-store-sqlite/dist/index.js'));\nconst {FileSystemCas}=await import(resolve(repo,'packages/cas/dist/index.js'));\nconst parent=await mkdtemp(resolve(tmpdir(),'lervo-recording-phases-'));\nconst results=[];\ntry {\n for (const workload of ['cold','warm','concurrent']) {\n  const root=resolve(parent,workload); await initializeActiveFixture(root);\n  const phases={},restore=[];\n  function wrap(obj,key,async) {\n   const original=obj[key], stat=phases[key]??={count:0,ms:0};\n   obj[key]=async? async function(...args){const start=performance.now();stat.count++;try{return await original.apply(this,args)}finally{stat.ms+=performance.now()-start}}:function(...args){const start=performance.now();stat.count++;try{return original.apply(this,args)}finally{stat.ms+=performance.now()-start}};\n   restore.push(()=>obj[key]=original);\n  }\n  wrap(SQLiteEventStore,'open',true);wrap(SQLiteEventStore.prototype,'transact',false);wrap(SQLiteEventStore.prototype,'verifyIntegrity',false);wrap(FileSystemCas.prototype,'putStream',true);\n  const session=new Session();session.connect();await session.post('Profiler.enable');await session.post('Profiler.start');\n  const worker=await activeWorker(root,'candidate',workload,4096,{warmups:2,samples:10,concurrency:4});\n  const {profile}=await session.post('Profiler.stop');session.disconnect();restore.forEach(fn=>fn());\n  const counts=new Map();const nodes=new Map(profile.nodes.map(n=>[n.id,n]));\n  for(const id of profile.samples??[]){const f=nodes.get(id).callFrame;const key=JSON.stringify([f.functionName,f.url.replace('file://'+repo+'/',''),f.lineNumber+1]);counts.set(key,(counts.get(key)??0)+1)}\n  results.push({workload,phases,semanticValid:worker.semanticValid,samples:worker.samples.map(x=>x.slice(0,2)),top:[...counts].sort((a,b)=>b[1]-a[1]).slice(0,30).map(([k,n])=>[...JSON.parse(k),n])});\n }\n await writeFile(process.argv[2],JSON.stringify({diagnosticOnly:true,results},null,2));\n}finally{await rm(parent,{recursive:true,force:true})}\n",
