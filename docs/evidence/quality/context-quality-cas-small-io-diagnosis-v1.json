  "scope": "Diagnostic-only same-process alternating prototype with fixed fixture. No provider calls or production mutations. Uncontrolled workstation and separate roots; no independent cold inference.",
  "script": "import fs from 'node:fs/promises';import sync from 'node:fs';import {syncBuiltinESMExports} from 'node:module';import{resolve}from'node:path';import{tmpdir}from'node:os';\nconst repo=process.cwd();const{initializeActiveFixture}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-fixture.mjs'));const{activeWorker}=await import(resolve(repo,'scripts/evaluation/lib/context-quality-active-worker.mjs'));\nconst parent=await fs.mkdtemp(resolve(tmpdir(),'lervo-cas-smallio-'));const results=[];const names=['open','mkdir','lstat','readFile','link','unlink'];const originals=Object.fromEntries(names.map(k=>[k,fs[k]]));const eligible=p=>String(p).includes('/cas/');\ntry{for(let cycle=0;cycle<3;cycle++)for(const mode of cycle%2?['small','async']:['async','small'])for(const workload of ['warm','concurrent']){\n const root=resolve(parent,`${cycle}-${mode}-${workload}`);await initializeActiveFixture(root);\n if(mode==='small'){\n  for(const name of names.filter(n=>n!=='open'))fs[name]=async(p,...args)=>eligible(p)?sync[name+'Sync'](p,...args):originals[name](p,...args);\n  fs.open=async(p,...args)=>{if(!eligible(p))return originals.open(p,...args);const fd=sync.openSync(p,...args);let closed=false;return{write:async(b,off,len,pos)=>({bytesWritten:sync.writeSync(fd,b,off,len,pos)}),sync:()=>new Promise((resolve,reject)=>sync.fsync(fd,e=>e?reject(e):resolve())),close:async()=>{if(!closed){closed=true;sync.closeSync(fd)}}}};syncBuiltinESMExports();\n }\n const r=await activeWorker(root,'candidate',workload,4096,{warmups:2,samples:10,concurrency:4});Object.assign(fs,originals);syncBuiltinESMExports();results.push({cycle,mode,workload,semanticValid:r.semanticValid,integrity:r.integrity,samples:r.samples.map(s=>s.slice(0,2))});\n}\nawait fs.writeFile('/tmp/lervo-cas-small-io-probe.json',JSON.stringify({diagnosticOnly:true,results},null,2));}finally{Object.assign(fs,originals);syncBuiltinESMExports();await fs.rm(parent,{recursive:true,force:true})}\n",
