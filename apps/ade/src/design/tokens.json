      "$type": "dimension",
      "$value": "2px"
    },
    "4": {
      "$type": "dimension",
      "$value": "4px"
    },
    "6": {
      "$type": "dimension",
      "$value": "6px"
    },
    "8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "10": {
      "$type": "dimension",
      "$value": "10px"
    },
    "12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "14": {
      "$type": "dimension",
      "$value": "14px"
    },
    "16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "28": {
      "$type": "dimension",
      "$value": "28px"
    },
    "32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "36": {
      "$type": "dimension",
      "$value": "36px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "border": {
    "width": {
      "strong": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "The question bar and other emphasized edges; hairlines stay 1 px"
      }
    }
  },
  "size": {
    "control": {
      "sm": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Segments of a segmented control"
      },
      "md": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "Chips, such as the agent and repository selects"
      },
      "lg": {
        "$type": "dimension",
        "$value": "34px",
        "$description": "Icon buttons in input cards, such as send"
      }
    },
    "dot": {
      "default": {
        "$type": "dimension",
        "$value": "6px",
        "$description": "Status dots and the working dot"
      },
      "attention": {
        "$type": "dimension",
        "$value": "7px",
        "$description": "The needs-you dot, a step larger so it reads without color"
      }
    },
    "icon": {
      "sm": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Icons beside caption and meta text"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Icons in list rows"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Icons in buttons"
      }
    },
    "logo": {
      "launch": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "The Lervo mark in the launch view, two pixels per unit of its 48-unit grid, so its edges stay sharp at every scale"
      }
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.45,
      "$description": "A control that cannot act now"
    }
  },
  "focus": {
    "ring": {
      "width": {
        "$type": "dimension",
        "$value": "2px"
      },
      "offset": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "A ring outside a free-standing control"
      },
      "inset": {
        "$type": "dimension",
        "$value": "-2px",
        "$description": "A ring inside a row, a segment, or a scrolling region, which would clip one outside"
      }
    }
  },
  "layout": {
    "sidebarWidth": {
      "$type": "dimension",
      "$value": "232px"
    },
    "sidebarMinWidth": {
      "$type": "dimension",
      "$value": "160px",
      "$description": "The workspace list in a narrow or zoomed window, which narrows instead of hiding"
    },
    "headerHeight": {
      "$type": "dimension",
      "$value": "48px"
    },
    "contentMaxWidth": {
      "$type": "dimension",
      "$value": "720px"
    },
    "collapseBelow": {
      "$type": "dimension",
      "$value": "760px"
    },
    "startMaxWidth": {
      "$type": "dimension",
      "$value": "640px",
      "$description": "The start screen column"
    },
    "bubbleMaxWidth": {
      "$type": "dimension",
      "$value": "80%",
      "$description": "The user's message bubbles, of the content column"
    }
  },
  "shadow": {
    "window": {
      "$type": "shadow",
      "$value": "0 30px 80px rgba(0,0,0,0.45)",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "0 30px 80px rgba(0,0,0,0.45)",
          "light": "0 30px 70px rgba(40,52,80,0.18), 0 0 0 1px rgba(20,30,50,0.06)"
        }
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "none",
          "light": "0 8px 24px rgba(40,52,80,0.08)"
        }
      }
    },
    "selected": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "none",
          "light": "0 1px 2px rgba(20,30,50,0.08)"
        }
      },
      "$description": "The selected row in the workspace list"
    }
  },
  "motion": {
    "duration": {
      "change": {
        "$type": "duration",
        "$value": "120ms"
      },
      "enter": {
        "$type": "duration",
        "$value": "200ms"
      },
      "exit": {
        "$type": "duration",
        "$value": "100ms"
      },
      "breathe": {
        "$type": "duration",
        "$value": "2400ms"
      },
      "shimmer": {
        "$type": "duration",
        "$value": "1800ms",
        "$description": "One sweep of the highlight across the working line"
      },
      "pace": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "How long streamed text takes to appear in full after it arrives"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 1, 1]
      },
      "breathe": {
        "$type": "cubicBezier",
        "$value": [0.42, 0, 0.58, 1]
      },
      "shimmer": {
        "$type": "cubicBezier",
        "$value": [0.45, 0, 0.55, 1]
      }
    },
    "breathe": {
      "minOpacity": {
        "$type": "number",
        "$value": 0.45
      }
    },
    "rise": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "How far an arriving element rises; translations move no farther"
    }
  },
  "terminal": {
    "background": {
      "$type": "color",
      "$value": "#0F1117",
