{
  "$description": "The Lervo ADE design tokens (W3C Design Tokens Community Group format). Values are the dark mode; dev.lervo.modes holds both modes. The visual language specification explains each token.",
  "palette": {
    "$description": "Primitive colors. Only semantic tokens alias them; components never read them, and the stylesheet does not expose them.",
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "25": {
        "$type": "color",
        "$value": "#FAFBFD"
      },
      "50": {
        "$type": "color",
        "$value": "#F4F5F8"
      },
      "100": {
        "$type": "color",
        "$value": "#ECEEF3"
      },
      "300": {
        "$type": "color",
        "$value": "#B4BAC7"
      },
      "400": {
        "$type": "color",
        "$value": "#A3AAB7"
      },
      "600": {
        "$type": "color",
        "$value": "#4C5361"
      },
      "650": {
        "$type": "color",
        "$value": "#454D5C"
      },
      "900": {
        "$type": "color",
        "$value": "#1A1C23"
      },
      "925": {
        "$type": "color",
        "$value": "#161B26"
      },
      "950": {
        "$type": "color",
        "$value": "#14161D"
      },
      "990": {
        "$type": "color",
        "$value": "#0B1020"
      }
    },
    "blue": {
      "300": {
        "$type": "color",
        "$value": "#A9C1FF"
      },
      "400": {
        "$type": "color",
        "$value": "#7AA2F7"
      },
      "600": {
        "$type": "color",
        "$value": "#3A64D8"
      },
      "700": {
        "$type": "color",
        "$value": "#2848AA"
      }
    },
    "amber": {
      "300": {
        "$type": "color",
        "$value": "#F2B661"
      },
      "700": {
        "$type": "color",
        "$value": "#975C06"
      }
    },
    "red": {
      "300": {
        "$type": "color",
        "$value": "#F29A8E"
      },
      "700": {
        "$type": "color",
        "$value": "#B42318"
      }
    },
    "green": {
      "300": {
        "$type": "color",
        "$value": "#8FD3B6"
      },
      "700": {
        "$type": "color",
        "$value": "#1A7F5A"
      }
    }
  },
  "glass": {
    "tint": {
      "color": {
        "$type": "color",
        "$value": "{palette.neutral.950}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.neutral.950}",
            "light": "{palette.neutral.25}"
          }
        }
      },
      "opacity": {
        "$type": "number",
        "$value": 0.75,
        "$extensions": {
          "dev.lervo.modes": {
            "dark": 0.75,
            "light": 0.6
          },
          "dev.lervo.contrast": {
            "dark": 1,
            "light": 1
          }
        }
      }
    },
    "overlay": {
      "blur": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "28px",
            "light": "30px"
          }
        }
      },
      "saturate": {
        "$type": "number",
        "$value": 1.5,
        "$extensions": {
          "dev.lervo.modes": {
            "dark": 1.5,
            "light": 1.6
          }
        }
      }
    }
  },
  "color": {
    "surface": {
      "opaque": {
        "$type": "color",
        "$value": "{palette.neutral.900}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.neutral.900}",
            "light": "{palette.neutral.50}"
          }
        }
      },
      "sidebar": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.03)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.03)",
            "light": "rgba(255,255,255,0.35)"
          }
        }
      },
      "input": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.05)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.05)",
            "light": "rgba(255,255,255,0.80)"
          }
        }
      },
      "selected": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.08)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.08)",
            "light": "rgba(255,255,255,0.85)"
          }
        }
      },
      "userMessage": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.08)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.08)",
            "light": "rgba(20,30,50,0.06)"
          }
        }
      },
      "terminal": {
        "$type": "color",
        "$value": "rgba(6,7,11,0.45)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(6,7,11,0.45)",
            "light": "rgba(247,248,250,0.72)"
          }
        },
        "$description": "The CLI conversation over the window glass"
      },
      "workspace": {
        "$type": "color",
        "$value": "rgba(255,255,255,0)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0)",
            "light": "rgba(255,255,255,0.35)"
          }
        },
        "$description": "The selected workspace over the window glass"
      },
      "floating": {
        "$type": "color",
        "$value": "rgba(30,32,40,0.62)",
        "$description": "The reply card and controls that float over the conversation, under the overlay blur",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(30,32,40,0.62)",
            "light": "rgba(255,255,255,0.62)"
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.048)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.048)",
            "light": "rgba(255,255,255,0.51)"
          }
        },
        "$description": "A row under the pointer, lighter than a selected row"
      },
      "code": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.06)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.06)",
            "light": "rgba(20,30,50,0.05)"
          }
        },
        "$description": "Code blocks and inline code in agent messages"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.06)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.06)",
            "light": "rgba(20,30,50,0.07)"
          },
          "dev.lervo.contrast": {
            "dark": "rgba(255,255,255,0.16)",
            "light": "rgba(20,30,50,0.20)"
          }
        }
      },
      "default": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.12)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.12)",
            "light": "rgba(20,30,50,0.10)"
          },
          "dev.lervo.contrast": {
            "dark": "rgba(255,255,255,0.30)",
            "light": "rgba(20,30,50,0.32)"
          }
        }
      },
      "window": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.10)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.10)",
            "light": "rgba(255,255,255,0.75)"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{palette.neutral.100}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.neutral.100}",
            "light": "{palette.neutral.925}"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{palette.neutral.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.neutral.300}",
            "light": "{palette.neutral.650}"
          },
          "dev.lervo.contrast": {
            "dark": "{palette.neutral.100}",
            "light": "{palette.neutral.925}"
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{palette.neutral.400}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.neutral.400}",
            "light": "{palette.neutral.600}"
          },
          "dev.lervo.contrast": {
            "dark": "{palette.neutral.300}",
            "light": "{palette.neutral.650}"
          }
        }
      },
      "link": {
        "$type": "color",
        "$value": "{palette.blue.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.blue.300}",
            "light": "{palette.blue.700}"
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{palette.blue.400}",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "{palette.blue.400}",
          "light": "{palette.blue.600}"
        }
      }
    },
    "onAccent": {
      "$type": "color",
      "$value": "{palette.neutral.990}",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "{palette.neutral.990}",
          "light": "{palette.neutral.0}"
        }
      }
    },
    "status": {
      "working": {
        "$type": "color",
        "$value": "{palette.blue.400}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.blue.400}",
            "light": "{palette.blue.600}"
          }
        }
      },
      "needsYou": {
        "$type": "color",
        "$value": "{palette.amber.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.amber.300}",
            "light": "{palette.amber.700}"
          }
        }
      },
      "failed": {
        "$type": "color",
        "$value": "{palette.red.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.red.300}",
            "light": "{palette.red.700}"
          }
        }
      }
    },
    "diff": {
      "added": {
        "$type": "color",
        "$value": "{palette.green.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.green.300}",
            "light": "{palette.green.700}"
          }
        }
      },
      "removed": {
        "$type": "color",
        "$value": "{palette.red.300}",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "{palette.red.300}",
            "light": "{palette.red.700}"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "interface": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"]
      }
    },
    "weight": {
      "$description": "Weights the interface uses; the typography roles name them.",
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "28px",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "18px",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.35
      }
    },
    "input": {
      "$type": "typography",
      "$value": {
        "fontSize": "15px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.55
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "14.5px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.7
      }
    },
    "list": {
      "$type": "typography",
      "$value": {
        "fontSize": "13.5px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.4
      }
    },
    "note": {
      "$type": "typography",
      "$value": {
        "fontSize": "13px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.6
      },
      "$description": "Explanations and inline errors; its line height also sets the user's message bubbles"
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontSize": "12.5px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.4
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "11.5px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.4
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontSize": "13px",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.75
      }
    }
  },
  "space": {
