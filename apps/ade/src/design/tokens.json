{
  "$description": "The Lervo ADE design tokens (W3C Design Tokens Community Group format). Values are the dark mode; dev.lervo.modes holds both modes. The visual language specification explains each token.",
  "glass": {
    "tint": {
      "color": {
        "$type": "color",
        "$value": "#14161D",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#14161D",
            "light": "#FAFBFD"
          }
        }
      },
      "opacity": {
        "$type": "number",
        "$value": 0.75,
        "$extensions": {
          "dev.lervo.modes": {
            "dark": 0.75,
            "light": 0.6
          }
        }
      }
    },
    "overlay": {
      "blur": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "28px",
            "light": "30px"
          }
        }
      },
      "saturate": {
        "$type": "number",
        "$value": 1.5,
        "$extensions": {
          "dev.lervo.modes": {
            "dark": 1.5,
            "light": 1.6
          }
        }
      }
    }
  },
  "color": {
    "surface": {
      "opaque": {
        "$type": "color",
        "$value": "#1A1C23",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#1A1C23",
            "light": "#F4F5F8"
          }
        }
      },
      "sidebar": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.03)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.03)",
            "light": "rgba(255,255,255,0.35)"
          }
        }
      },
      "input": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.05)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.05)",
            "light": "rgba(255,255,255,0.80)"
          }
        }
      },
      "selected": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.08)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.08)",
            "light": "rgba(255,255,255,0.85)"
          }
        }
      },
      "userMessage": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.08)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.08)",
            "light": "rgba(20,30,50,0.06)"
          }
        }
      },
      "terminal": {
        "$type": "color",
        "$value": "rgba(6,7,11,0.45)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(6,7,11,0.45)",
            "light": "rgba(247,248,250,0.72)"
          }
        },
        "$description": "The CLI conversation over the window glass"
      },
      "workspace": {
        "$type": "color",
        "$value": "rgba(255,255,255,0)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0)",
            "light": "rgba(255,255,255,0.35)"
          }
        },
        "$description": "The selected workspace over the window glass"
      },
      "floating": {
        "$type": "color",
        "$value": "rgba(30,32,40,0.62)",
        "$description": "The reply card and controls that float over the conversation, under the overlay blur",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(30,32,40,0.62)",
            "light": "rgba(255,255,255,0.62)"
          }
        }
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.06)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.06)",
            "light": "rgba(20,30,50,0.07)"
          }
        }
      },
      "default": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.12)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.12)",
            "light": "rgba(20,30,50,0.10)"
          }
        }
      },
      "window": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.10)",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "rgba(255,255,255,0.10)",
            "light": "rgba(255,255,255,0.75)"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#ECEEF3",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#ECEEF3",
            "light": "#161B26"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#B4BAC7",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#B4BAC7",
            "light": "#454D5C"
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "#A3AAB7",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#A3AAB7",
            "light": "#4C5361"
          }
        }
      },
      "link": {
        "$type": "color",
        "$value": "#A9C1FF",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#A9C1FF",
            "light": "#2848AA"
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#7AA2F7",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "#7AA2F7",
          "light": "#3A64D8"
        }
      }
    },
    "onAccent": {
      "$type": "color",
      "$value": "#0B1020",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "#0B1020",
          "light": "#FFFFFF"
        }
      }
    },
    "status": {
      "working": {
        "$type": "color",
        "$value": "#7AA2F7",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#7AA2F7",
            "light": "#3A64D8"
          }
        }
      },
      "needsYou": {
        "$type": "color",
        "$value": "#F2B661",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#F2B661",
            "light": "#975C06"
          }
        }
      },
      "failed": {
        "$type": "color",
        "$value": "#F29A8E",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#F29A8E",
            "light": "#B42318"
          }
        }
      }
    },
    "diff": {
      "added": {
        "$type": "color",
        "$value": "#8FD3B6",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#8FD3B6",
            "light": "#1A7F5A"
          }
        }
      },
      "removed": {
        "$type": "color",
        "$value": "#F29A8E",
        "$extensions": {
          "dev.lervo.modes": {
            "dark": "#F29A8E",
            "light": "#B42318"
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "interface": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"]
      }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "28px",
        "fontWeight": 500,
        "lineHeight": 1.25
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.35
      }
    },
    "input": {
      "$type": "typography",
      "$value": {
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.55
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "14.5px",
        "fontWeight": 400,
        "lineHeight": 1.7
      }
    },
    "list": {
      "$type": "typography",
      "$value": {
        "fontSize": "13.5px",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontSize": "12.5px",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "11.5px",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.75
      }
    }
  },
  "space": {
    "2": {
      "$type": "dimension",
      "$value": "2px"
    },
    "4": {
      "$type": "dimension",
      "$value": "4px"
    },
    "6": {
      "$type": "dimension",
      "$value": "6px"
    },
    "8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "10": {
      "$type": "dimension",
      "$value": "10px"
    },
    "12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "14": {
      "$type": "dimension",
      "$value": "14px"
    },
    "16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "28": {
      "$type": "dimension",
      "$value": "28px"
    },
    "32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "36": {
      "$type": "dimension",
      "$value": "36px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "layout": {
    "sidebarWidth": {
      "$type": "dimension",
      "$value": "232px"
    },
    "headerHeight": {
      "$type": "dimension",
      "$value": "48px"
    },
    "contentMaxWidth": {
      "$type": "dimension",
      "$value": "720px"
    },
    "collapseBelow": {
      "$type": "dimension",
      "$value": "760px"
    }
  },
  "shadow": {
    "window": {
      "$type": "shadow",
      "$value": "0 30px 80px rgba(0,0,0,0.45)",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "0 30px 80px rgba(0,0,0,0.45)",
          "light": "0 30px 70px rgba(40,52,80,0.18), 0 0 0 1px rgba(20,30,50,0.06)"
        }
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "none",
          "light": "0 8px 24px rgba(40,52,80,0.08)"
        }
      }
    },
    "selected": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "none",
          "light": "0 1px 2px rgba(20,30,50,0.08)"
        }
      },
      "$description": "The selected row in the workspace list"
    }
  },
  "motion": {
    "duration": {
      "change": {
        "$type": "duration",
        "$value": "120ms"
      },
      "enter": {
        "$type": "duration",
        "$value": "200ms"
      },
      "exit": {
        "$type": "duration",
        "$value": "100ms"
      },
      "breathe": {
        "$type": "duration",
        "$value": "2400ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 1, 1]
      },
      "breathe": {
        "$type": "cubicBezier",
        "$value": [0.42, 0, 0.58, 1]
      }
    },
    "breathe": {
      "minOpacity": {
        "$type": "number",
        "$value": 0.45
      }
    }
  },
  "terminal": {
    "background": {
      "$type": "color",
      "$value": "#0F1117",
      "$extensions": {
        "dev.lervo.modes": {
          "dark": "#0F1117",
          "light": "#F7F8FA"
        }
