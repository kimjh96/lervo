{
  "name": "@lervo/cli",
  "version": "0.1.0",
  "description": "Lervo CLI for managing AI agent execution and evidence in local repositories",
  "keywords": [
    "ai-agents",
    "local-first",
    "orchestration"
  ],
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lervo": "./dist/bin.js",
    "lervo-node": "./dist/node-runtime.js"
  },
  "files": [
    "README.md",
    "dist/bin.js",
    "dist/node-runtime.js",
    "dist/terminal-hook.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@anthropic-ai/sdk": "0.117.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@lervo/agent-workforce": "workspace:*",
    "@lervo/capabilities": "workspace:*",
    "@lervo/adapter-contract": "workspace:*",
    "@lervo/adapter-claude": "workspace:*",
    "@lervo/adapter-codex": "workspace:*",
    "@lervo/context": "workspace:*",
    "@lervo/conversation-control": "workspace:*",
    "@lervo/conversation-deliberation-sqlite": "workspace:*",
    "@lervo/core": "workspace:*",
    "@lervo/deliberation": "workspace:*",
    "@lervo/deliberation-runtime": "workspace:*",
    "@lervo/diagnostics": "workspace:*",
    "@lervo/event-contract": "workspace:*",
    "@lervo/environment": "workspace:*",
    "@lervo/environment-adapter-tailscale": "workspace:*",
    "@lervo/identity-migration": "workspace:*",
    "@lervo/knowledge-okf": "workspace:*",
    "@lervo/node-runtime": "workspace:*",
    "@lervo/orchestrator": "workspace:*",
    "@lervo/project": "workspace:*",
    "@lervo/project-storage": "workspace:*",
    "@lervo/repository-registry": "workspace:*",
    "@lervo/repository-knowledge": "workspace:*",
    "@lervo/repository-knowledge-compiler": "workspace:*",
    "@lervo/roles": "workspace:*",
    "@lervo/search": "workspace:*",
    "@lervo/search-adapter-bm25f": "workspace:*",
    "@lervo/search-adapter-local-hybrid": "workspace:*",
    "@lervo/search-local": "workspace:*",
    "@lervo/schemas": "workspace:*",
    "@lervo/skills": "workspace:*",
    "@lervo/storage-contract": "workspace:*",
    "@lervo/verification": "workspace:*",
    "@lervo/writing": "workspace:*",
    "@lervo/writing-contract": "workspace:*",
    "yaml": "2.9.0",
    "esbuild": "0.28.2"
  }
}
