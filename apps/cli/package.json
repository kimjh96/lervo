{
  "name": "@lervo/cli",
  "version": "0.46.4",
  "description": "Lervo CLI for managing AI agent execution and evidence in local repositories",
  "keywords": [
    "ai-agents",
    "local-first",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lervo": "./dist/bin.js",
    "lervo-node": "./dist/node-runtime.js"
  },
  "files": [
    "README.md",
    "dist/bin.js",
    "dist/native/cas-io-darwin.node",
    "dist/native/cas-io.json",
    "dist/native/file-sync-darwin.node",
    "dist/native/file-sync.json",
    "dist/node-runtime.js",
    "dist/repository-runtime-*.cjs",
    "dist/repository-runtime-*.js",
    "dist/repository-runtime.js",
    "dist/repository-runtime.json",
    "dist/terminal-hook-launcher.mjs",
    "dist/terminal-hook.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@anthropic-ai/sdk": "0.117.1",
    "@modelcontextprotocol/sdk": "1.30.0",
