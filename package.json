{
  "name": "lervo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "brand:check": "node scripts/check-brand.mjs",
    "architecture:check": "node scripts/check-package-boundaries.mjs",
    "build": "pnpm -r --sort --workspace-concurrency=1 run build",
    "check": "pnpm quality:check && pnpm architecture:check && pnpm typecheck && pnpm test && pnpm build && pnpm release:manifest:check && pnpm release:sbom:check && pnpm release:attestation:check && pnpm smoke:built-cli && pnpm smoke:built-hub && pnpm smoke:hub-distribution && pnpm smoke:built-node && pnpm smoke:node-distribution && pnpm smoke:packed-cli && pnpm smoke:registry-publish && pnpm docs:check && pnpm brand:check",
    "commit:lint": "commitlint",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/lervo/prettier",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/lervo/prettier",
    "language:audit": "node scripts/audit-product-language.mjs",
    "language:check": "node scripts/audit-product-language.mjs --strict",
    "lint": "eslint . --cache --cache-location node_modules/.cache/lervo/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/lervo/eslint",
    "pilot:managed-provider:https": "node scripts/run-real-managed-provider-https-pilot.mjs",
    "pilot:knowledge-compilation": "node scripts/run-real-knowledge-compilation-pilot.mjs",
    "service:render": "node scripts/render-runtime-service.mjs",
    "service:manage": "node scripts/manage-runtime-service.mjs",
    "quality:check": "pnpm lint && pnpm format:check",
    "runtime:preflight": "node scripts/check-runtime-readiness.mjs",
    "hub:distribution:build": "node scripts/build-hub-runtime-distribution.mjs",
    "hub:distribution:verify": "node scripts/verify-hub-runtime-distribution.mjs",
    "hub:distribution:install": "node scripts/install-hub-runtime-distribution.mjs",
    "node:distribution:build": "node scripts/build-node-runtime-distribution.mjs",
    "node:distribution:verify": "node scripts/verify-node-runtime-distribution.mjs",
    "node:distribution:install": "node scripts/install-node-runtime-distribution.mjs",
    "lervo": "node apps/cli/dist/bin.js",
    "lervo:hub": "node apps/hub-runtime/dist/bin.js",
    "lervo:node": "node apps/node-runtime/dist/bin.js",
    "release:manifest:check": "node scripts/check-cli-release-artifact.mjs",
    "release:manifest:update": "node scripts/check-cli-release-artifact.mjs --write",
    "release:sbom:check": "node scripts/check-cli-release-sbom.mjs",
    "release:sbom:update": "node scripts/check-cli-release-sbom.mjs --write",
    "release:attestation:check": "node scripts/check-cli-release-attestation.mjs",
    "release:attestation:local": "node scripts/check-cli-release-attestation.mjs --statement",
    "release:attestation:prepare": "node scripts/check-cli-release-attestation.mjs --prepare",
    "release:attestation:verify": "node scripts/verify-cli-release-attestation.mjs",
    "release:publication:authorize": "node scripts/authorize-cli-release-publication.mjs",
    "release:publication:stage": "node scripts/stage-cli-release-publication.mjs",
    "release:publisher:readiness": "node scripts/check-cli-trusted-publisher-readiness.mjs",
    "release:bootstrap:authorize": "node scripts/authorize-cli-first-publication-bootstrap.mjs",
    "release:bootstrap:preflight": "node scripts/check-cli-first-publication-preflight.mjs",
    "release:bootstrap:reconcile": "node scripts/check-cli-first-publication-reconciliation.mjs",
    "release:bootstrap:resolve": "node scripts/resolve-cli-first-publication-reconciliation.mjs",
    "release:bootstrap:transition": "node scripts/complete-cli-first-publication-transition.mjs",
    "release:bootstrap:workflow-candidate": "node scripts/show-cli-first-publication-workflow-activation-candidate.mjs",
    "release:bootstrap:workflow-permit": "node scripts/authorize-cli-first-publication-workflow-activation.mjs",
    "release:bootstrap:workflow-apply": "node scripts/apply-cli-first-publication-workflow-activation.mjs",
    "release:bootstrap:workflow-verify": "node scripts/verify-cli-first-publication-workflow-activation-post-apply.mjs",
    "release:bootstrap:workflow-remote-evidence": "node scripts/show-cli-first-publication-workflow-remote-deployment-evidence.mjs",
    "release:bootstrap:workflow-reachability": "node scripts/show-cli-first-publication-workflow-reachability-evidence.mjs",
    "release:bootstrap:workflow-execution": "node scripts/show-cli-first-publication-workflow-execution-evidence.mjs",
    "release:bootstrap:stage-result-evidence": "node scripts/show-cli-first-publication-stage-result-evidence.mjs",
    "release:bootstrap:stage-review-evidence": "node scripts/show-cli-first-publication-stage-review-evidence.mjs",
    "release:bootstrap:stage-approve-authorize": "node scripts/authorize-cli-first-publication-stage-approval.mjs",
    "release:bootstrap:stage-approve": "node scripts/approve-cli-first-publication-stage.mjs",
    "release:bootstrap:stage-approve-reconcile": "node scripts/reconcile-cli-first-publication-stage-approval.mjs",
    "release:bootstrap:stage-evidence-bundle": "node scripts/create-cli-first-publication-stage-evidence-bundle.mjs",
    "release:bootstrap:completion-inspect": "node scripts/inspect-cli-first-publication-completion.mjs",
    "release:bootstrap:plan": "node scripts/show-cli-first-publication-execution-plan.mjs",
    "release:bootstrap:arm": "node scripts/authorize-cli-first-publication-arming.mjs",
    "release:bootstrap:blockers": "node scripts/show-cli-first-publication-activation-blockers.mjs",
    "release:bootstrap:metadata-preview": "node scripts/show-cli-first-publication-metadata-preview.mjs",
    "release:bootstrap:metadata-candidate": "node scripts/show-cli-first-publication-package-metadata-candidate.mjs",
    "release:bootstrap:metadata-permit": "node scripts/show-cli-first-publication-package-metadata-apply-permit.mjs",
    "release:bootstrap:metadata-apply": "node scripts/apply-cli-first-publication-package-metadata.mjs",
    "release:bootstrap:metadata-verify": "node scripts/verify-cli-first-publication-package-metadata-post-apply.mjs",
    "release:bootstrap:external-evidence": "node scripts/show-cli-first-publication-external-evidence.mjs",
    "smoke:built-cli": "node scripts/check-built-cli.mjs",
    "smoke:built-hub": "node scripts/check-built-hub-runtime.mjs",
    "smoke:hub-distribution": "node scripts/check-hub-runtime-distribution.mjs",
    "smoke:built-node": "node scripts/check-built-node-runtime.mjs",
    "smoke:node-distribution": "node scripts/check-node-runtime-distribution.mjs",
    "smoke:packed-cli": "node scripts/check-packed-cli.mjs",
    "smoke:registry-publish": "node scripts/check-registry-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "npm": "11.18.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.67.0",
    "verdaccio": "6.10.0",
    "vitest": "^3.2.0",
    "yaml": "2.9.0"
  }
}
