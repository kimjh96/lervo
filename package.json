    "foundation:replay:check": "node scripts/check-foundation-focused-suite.mjs --area replay",
    "foundation:journeys:check": "node scripts/check-foundation-focused-suite.mjs --area journeys",
    "foundation:fresh-clone:check": "node scripts/check-foundation-fresh-clone.mjs",
