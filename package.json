    "commit:lint": "commitlint",
    "code-convention:check": "node scripts/check-code-convention.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "evaluation:grounding:run": "node scripts/run-grounding-evaluation.mjs",
