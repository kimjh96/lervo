    "pilot:linked-evidence-provider-shadow-v13": "node scripts/run-linked-evidence-provider-shadow-pilot-v13.mjs",
    "pilot:linked-evidence-provider-shadow-v14": "node scripts/run-linked-evidence-provider-shadow-pilot-v14.mjs",
    "pilot:linked-evidence-managed-canary-v15": "node scripts/run-linked-evidence-managed-canary-v15.mjs",
    "pilot:linked-evidence-managed-canary-v16": "node scripts/run-linked-evidence-managed-canary-v16.mjs",
    "pilot:linked-evidence-managed-canary-v17": "node scripts/run-linked-evidence-managed-canary-v17.mjs",
    "pilot:linked-evidence-managed-canary-v18": "node scripts/run-linked-evidence-managed-canary-v18.mjs",
