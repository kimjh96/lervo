    "foundation:readiness:check": "node scripts/check-foundation-readiness.mjs",
    "foundation:check": "pnpm build && node scripts/run-foundation-check.mjs",
    "language:audit": "node scripts/audit-product-language.mjs",
    "language:check": "node scripts/audit-product-language.mjs --strict",
