  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "npm": "11.18.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.67.0",
    "verdaccio": "6.10.0",
    "vitest": "^3.2.0",
    "yaml": "2.9.0"
  }
}
